{
  "name": "mcp-qa-server",
  "version": "0.1.0",
  "description": "Reusable MCP server for QA automation testing across multiple project types",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "mcp-qa": "dist/bin/mcp-qa.js"
  },
  "scripts": {
